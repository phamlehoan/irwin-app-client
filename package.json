{
  "name": "warehouse-app-client",
  "version": "0.0.1",
  "description": "Frontend for Áng Dương production & warehouse platform.",
  "productName": "Áng Dương Platform",
  "author": "Hoan Pham <hoan_pham@datahouse.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "start": "pnpm dlx serve dist/spa -s -l 9000",
    "dev:pwa": "quasar dev -m pwa",
    "dev:pwa:start": "pnpm dlx serve dist/pwa -s -l 9000",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "build:cap:android": "quasar build -m capacitor -T android -s && cd src-capacitor && pnpm exec cap sync android",
    "build:cap:ios": "quasar build -m capacitor -T ios -s && cd src-capacitor && pnpm exec cap sync ios",
    "build:android:release": "quasar build -m capacitor -T android",
    "cap:sync": "cd src-capacitor && pnpm exec cap sync",
    "cap:open:android": "cd src-capacitor && pnpm exec cap open android",
    "cap:open:ios": "cd src-capacitor && pnpm exec cap open ios",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.3",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.15.2",
    "dompurify": "^3.4.1",
    "firebase": "^12.12.1",
    "marked": "^18.0.2",
    "md-editor-v3": "^6.4.2",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^2.5.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.19.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6",
    "workbox-build": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 9.0.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
